# Copiez ce fichier en .streamlit/secrets.toml (jamais sur GitHub !)
# ou collez son contenu dans Streamlit Cloud > Settings > Secrets.

# Base PostgreSQL gratuite (Neon, Supabase…) : indispensable pour garder les données sur Streamlit Cloud.
DATABASE_URL = "postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Serveur d'appels (facultatif). Par défaut : https://meet.jit.si
# CALL_BASE_URL = "https://meet.jit.si"
